# Copy this file to .env for local development.
# Generate both secrets with: openssl rand -base64 32
NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcrm
DATABASE_SSL=false
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET
DATA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_BASE64_32_BYTE_KEY

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Clinic Administrator
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Server-side only. Never put this key in config.js or browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://alekh999.github.io
CLINIC_NAME=Jabalpur Clinic
CLINIC_ADDRESS=Not configured
CLINIC_HOURS=Not configured
CLINIC_PHONE=Not configured
